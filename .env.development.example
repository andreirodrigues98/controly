# CONTROLY — Copie como .env.development (NAO versionar).
# Configuracao do app WEB do Firebase, nunca a chave privada de uma conta de servico.
FIREBASE_API_KEY=COLE_AQUI
FIREBASE_AUTH_DOMAIN=COLE_AQUI
FIREBASE_PROJECT_ID=COLE_AQUI
FIREBASE_STORAGE_BUCKET=COLE_AQUI
FIREBASE_MESSAGING_SENDER_ID=COLE_AQUI
FIREBASE_APP_ID=COLE_AQUI
# Repita exatamente o ID acima para confirmar o projeto:
CONTROLY_DEV_PROJECT_CONFIRMED=COLE_AQUI
# Opcional: somente depois de registrar o app de desenvolvimento no App Check.
# NUNCA reutilize a chave de App Check de producao em localhost.
CONTROLY_APPCHECK_SITE_KEY=
CONTROLY_APPCHECK_DEBUG=false

# Habilite somente depois de publicar e testar o Worker e as regras:
CONTROLY_ADMIN_BACKEND_ENABLED=false

# API administrativa gratuita, apos publicar e testar o Worker e as regras.
# Use a URL real https://<nome>.workers.dev sem barra final.
CONTROLY_ADMIN_WORKER_URL=https://controly-vora-admin.andreirodrigues1510.workers.dev
