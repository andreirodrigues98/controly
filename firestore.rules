// CONTROLY — REGRAS GERAIS DO FIRESTORE
// Usadas por usuarios, biblioteca, financas, perfil e controle de suspensao.
// O Cloudflare Worker usa uma conta de servico: suas operacoes nao dependem destas regras.
// Antes de publicar: confira o projeto, salve uma copia das regras atuais e teste com duas contas.
// Contas SEM accountAccess continuam ativas para permitir migracao sem bloquear usuarios.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Contas sem registro de acesso continuam ativas, facilitando migração segura.
    // Somente o Worker (service account) pode escrever status e auditoria.
    function canUseAccount(uid) {
      return isOwner(uid) && (
        !exists(/databases/$(database)/documents/accountAccess/$(uid)) ||
        get(/databases/$(database)/documents/accountAccess/$(uid)).data.status == 'active'
      );
    }

    function knownUserCollection(name) {
      return name in [
        'activities', 'tasks', 'habits', 'routines', 'events', 'goals',
        'notes', 'subjects', 'studySessions', 'studyMaterials',
        'readingItems', 'workouts', 'financeCards', 'financeEntries', 'trash'
      ];
    }

    function basicProfileIsValid(userId) {
      return request.resource.data is map
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'lastLoginAt', 'updatedAt', 'avatarDataUrl', 'createdAt'
        ])
        && request.resource.data.keys().hasAll(['uid', 'email', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 150
        && (!('avatarDataUrl' in request.resource.data) || (
          request.resource.data.avatarDataUrl is string
          && request.resource.data.avatarDataUrl.size() <= 75000
          && (request.resource.data.avatarDataUrl == '' ||
              request.resource.data.avatarDataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))
        ));
    }

    function profileUpdateIsValid(userId) {
      return request.resource.data is map
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        // Um usuario nunca pode alterar uid, createdAt, status, plano ou permissoes.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'lastLoginAt', 'updatedAt', 'avatarDataUrl'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 150
        && (!('avatarDataUrl' in request.resource.data) || (
          request.resource.data.avatarDataUrl is string
          && request.resource.data.avatarDataUrl.size() <= 75000
          && (request.resource.data.avatarDataUrl == '' ||
              request.resource.data.avatarDataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))
        ));
    }

    function personalDocumentIsValid() {
      return request.resource.data is map
        && request.resource.data.keys().size() <= 120
        // Nao permitir que documentos pessoais simulem metadados administrativos.
        && !request.resource.data.keys().hasAny([
          'isAdmin', 'isSuperAdmin', 'role', 'accountStatus',
          'subscriptionStatus', 'adminClaims', 'permissions'
        ]);
    }

    match /users/{userId} {
      allow get: if canUseAccount(userId);
      allow list: if false;
      allow create: if canUseAccount(userId) && basicProfileIsValid(userId);
      allow update: if canUseAccount(userId) && profileUpdateIsValid(userId);
      allow delete: if false;

      match /{collectionName}/{recordId} {
        allow get, list, delete: if canUseAccount(userId) && knownUserCollection(collectionName);
        allow create, update: if canUseAccount(userId)
          && knownUserCollection(collectionName)
          && personalDocumentIsValid();
      }
    }
    match /accountAccess/{uid} {
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;
    }
    match /adminAudit/{recordId} { allow read, write: if false; }
    // Qualquer outro caminho permanece bloqueado por padrao.
  }
}
