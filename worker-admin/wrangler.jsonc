{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "controly-vora-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {
    "FIREBASE_PROJECT_ID": "controly-ec636",
    "ALLOWED_ORIGINS": "http://127.0.0.1:5500,http://localhost:5500"
  },
  "ratelimits": [
    { "name": "ADMIN_READ_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "ADMIN_WRITE_LIMIT", "namespace_id": "1002", "simple": { "limit": 8, "period": 60 } }
  ]
}
